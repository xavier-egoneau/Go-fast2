# Figma MCP - requis pour /gofast-from-figma
# FIGMA_API_KEY=your_figma_api_key_here

# IA — choisir un provider : 'claude' ou 'ollama'
# AI_PROVIDER=ollama
# AI_MODEL=llama3

# Clé API commune (Anthropic key si claude, token Bearer si ollama cloud)
# PROVIDER_API_KEY=...

# URL du provider (ollama uniquement — local ou cloud)
# PROVIDER_URL=https://your-ollama-instance.com
