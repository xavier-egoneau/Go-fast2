<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Go-fast — Design Surface</title>
  <link rel="stylesheet" href="/app/styles/showcase.scss">
</head>
<body class="gf-app" data-view="bigpicture" data-agent="open">

  <!-- ─── Topbar ──────────────────────────────────────────────────────────── -->
  <header class="gf-topbar" id="gf-topbar">

    <div class="gf-topbar__left">
      <button class="gf-scene-tab" id="gf-scene-tab" type="button" aria-label="Vue d'ensemble">
        <svg class="gf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
        Design Surface
      </button>

      <button class="gf-btn-create" id="gf-create-btn" type="button">
        <svg class="gf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Créer un composant
      </button>
    </div>

    <div class="gf-topbar__center">
      <p class="gf-scene-info" id="gf-scene-info">Chargement…</p>
      <div class="gf-tabs" id="gf-tabs" hidden aria-label="Vues ouvertes"></div>
    </div>

    <div class="gf-topbar__right">
      <button class="gf-topbar-action" id="gf-agent-toggle" type="button" title="Panneau agent" aria-label="Basculer le panneau agent" aria-pressed="true">
        <svg class="gf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2a7 7 0 0 1 7 7c0 3.5-2.5 6.4-5.8 7V18h-2.4v-2a7 7 0 0 1-5.8-7 7 7 0 0 1 7-7z"/>
          <line x1="9" y1="21" x2="15" y2="21"/>
        </svg>
        Agent
      </button>
    </div>

  </header>

  <!-- ─── Workspace ──────────────────────────────────────────────────────── -->
  <div class="gf-workspace">

    <!-- Agent panel — gauche -->
    <aside class="gf-agent" id="gf-agent" aria-label="Panneau agent">

      <div class="gf-agent__header">
        <span class="gf-agent__title">Agent</span>
        <button class="gf-agent__model-btn" id="gf-model-btn" type="button" aria-label="Changer de modèle">
          <span class="gf-model-dot" id="gf-model-dot"></span>
          <span id="gf-model-name">Claude</span>
          <svg class="gf-icon gf-icon--xs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
      </div>

      <div class="gf-agent__history" id="gf-agent-history">
        <div class="gf-agent__empty">
          <svg class="gf-icon gf-icon--lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2a7 7 0 0 1 7 7c0 3.5-2.5 6.4-5.8 7V18h-2.4v-2a7 7 0 0 1-5.8-7 7 7 0 0 1 7-7z"/>
            <line x1="9" y1="21" x2="15" y2="21"/>
          </svg>
          <p>L'agent est prêt.<br>Sélectionne un composant ou décris ce que tu veux créer.</p>
        </div>
      </div>

      <div class="gf-agent__context" id="gf-agent-context" hidden>
        <span class="gf-context-label">Contexte actif</span>
        <span class="gf-context-value" id="gf-context-value"></span>
      </div>

      <div class="gf-agent__footer">
        <div class="gf-agent__tools">
          <button class="gf-agent-tool" type="button" title="Upload un fichier" aria-label="Uploader un fichier">
            <svg class="gf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
          </button>
          <button class="gf-agent-tool" type="button" title="Chercher sur le web" aria-label="Recherche web">
            <svg class="gf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </button>
          <button class="gf-agent-tool" type="button" title="Skills design" aria-label="Skills design">
            <svg class="gf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </button>
        </div>

        <div class="gf-agent__compose">
          <textarea
            class="gf-agent__textarea"
            id="gf-agent-input"
            placeholder="Décris ce que tu veux créer ou modifier…"
            rows="3"
            aria-label="Message à l'agent"
          ></textarea>
          <button class="gf-agent__send" id="gf-agent-send" type="button">
            Générer
            <svg class="gf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
          </button>
        </div>
      </div>

    </aside>

    <!-- Surface de design — centre -->
    <main class="gf-surface" id="gf-surface" aria-label="Surface de design">

      <!-- Contrôle zoom — overlay top-right -->
      <div class="gf-zoom-overlay" id="gf-zoom-overlay" aria-label="Zoom">
        <button class="gf-zoom-btn" id="gf-zoom-out" type="button" aria-label="Dézoomer">−</button>
        <span class="gf-zoom-value" id="gf-zoom-value" aria-live="polite">100%</span>
        <button class="gf-zoom-btn" id="gf-zoom-in" type="button" aria-label="Zoomer">+</button>
      </div>

      <!-- Big picture : grille par niveau -->
      <div class="gf-bigpicture" id="gf-bigpicture">
        <div class="gf-levels" id="gf-levels">
          <p class="gf-surface-msg">Chargement des composants…</p>
        </div>
      </div>

      <!-- Focus : iframe plein centre -->
      <div class="gf-focus" id="gf-focus" hidden>

        <div class="gf-focus__toolbar">
          <button class="gf-focus-tool" id="gf-toggle-code" type="button" aria-label="Voir le code source" aria-pressed="false">
            <svg class="gf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
            </svg>
            Code
          </button>
          <button class="gf-focus-tool" id="gf-toggle-a11y" type="button" aria-label="Test accessibilité" aria-pressed="false">
            <svg class="gf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="4" r="2"/>
              <path d="M12 6v8M9 21l3-7 3 7M5 11l7-2 7 2"/>
            </svg>
            A11y
          </button>
          <span class="gf-viewport-size" id="gf-viewport-size" aria-live="polite"></span>
        </div>

        <div class="gf-focus__preview" id="gf-focus-preview">
          <iframe
            id="gf-preview-frame"
            class="gf-preview-frame"
            title="Aperçu du composant"
          ></iframe>

          <div class="gf-code-panel" id="gf-code-panel" hidden aria-label="Code source" role="region">
            <div class="gf-code-panel__bar">
              <span class="gf-code-panel__lang">HTML</span>
              <button class="gf-code-panel__copy" id="gf-copy-code" type="button">
                <svg class="gf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
                Copier
              </button>
            </div>
            <pre class="gf-code-panel__pre language-html"><code class="language-html" id="gf-code-content"></code></pre>
          </div>

          <div class="gf-preview-error" id="gf-preview-error" hidden role="alert"></div>
        </div>

        <div class="gf-a11y-panel" id="gf-a11y-panel" hidden aria-label="Résultats accessibilité" aria-live="polite"></div>

      </div>

    </main>

    <!-- Inspector panel — droite -->
    <aside class="gf-inspector" id="gf-inspector" aria-label="Inspecteur">

      <div class="gf-inspector__tabs" role="tablist" aria-label="Onglets inspecteur">
        <button class="gf-itab gf-itab--active" data-panel="variants" role="tab" aria-selected="true" type="button">Variantes</button>
        <button class="gf-itab" data-panel="comments" role="tab" aria-selected="false" type="button">Commentaires</button>
      </div>

      <div class="gf-inspector__body" id="gf-inspector-body" role="tabpanel">
        <div class="gf-inspector__empty">
          <svg class="gf-icon gf-icon--lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          <p>Sélectionne un composant pour voir ses variantes.</p>
        </div>
      </div>

    </aside>

  </div>

  <!-- Dialog confirmation suppression -->
  <div class="gf-dialog" id="gf-delete-dialog" hidden role="dialog" aria-modal="true" aria-labelledby="gf-dialog-title">
    <div class="gf-dialog__box">
      <h2 class="gf-dialog__title" id="gf-dialog-title">Supprimer le composant ?</h2>
      <p class="gf-dialog__body" id="gf-dialog-body"></p>
      <div class="gf-dialog__actions">
        <button class="gf-dialog__cancel" id="gf-dialog-cancel" type="button">Annuler</button>
        <button class="gf-dialog__confirm" id="gf-dialog-confirm" type="button">Supprimer</button>
      </div>
    </div>
    <div class="gf-dialog__backdrop" id="gf-dialog-backdrop"></div>
  </div>

  <script src="/node_modules/prismjs/prism.js"></script>
  <script src="/node_modules/prismjs/components/prism-markup.min.js"></script>
  <script type="module" src="/app/scripts/showcase.js"></script>
  <script type="module" src="/app/scripts/quality.js"></script>
</body>
</html>
