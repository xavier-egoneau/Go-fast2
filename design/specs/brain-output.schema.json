{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Surface Brain Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "actions",
    "warnings",
    "requiresNewComponent",
    "unresolved"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiresNewComponent": {
      "type": "boolean"
    },
    "unresolved": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": true
          }
        ]
      }
    }
  }
}
