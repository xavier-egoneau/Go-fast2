{
  "name": "Grid",
  "level": "atom",
  "category": "Layout",
  "description": "Ligne CSS Grid 12 colonnes. Chaque enfant utilise .grid-item + .grid--cols-N pour definir son span (ex. cols-6 = 50%, cols-12 = 100%).",
  "variants": {
    "gap": {
      "label": "Gap",
      "type": "select",
      "default": "md",
      "options": ["none", "xs", "sm", "md", "lg", "xl"]
    },
    "align": {
      "label": "Align items",
      "type": "select",
      "default": "stretch",
      "options": ["stretch", "start", "center", "end"]
    }
  },
  "content": {
    "tag": {
      "label": "Element HTML",
      "type": "text",
      "default": "div"
    }
  }
}
